# Copy to .env. Used by the local API, migrations and the seed script.

# "pg" = local Postgres; "data-api" = Aurora via the RDS Data API (no VPC needed).
DB_DRIVER=pg
DATABASE_URL=postgres://postgres@localhost:5432/pol

# Only for DB_DRIVER=data-api (values come from the CDK stack outputs).
# AWS_PROFILE must be the PERSONAL account: default (294983767092). Never "work".
AWS_PROFILE=default
AWS_REGION=eu-west-2
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=pol

# "dev" trusts the x-dev-user header (local only). AWS always uses "cognito".
AUTH_MODE=dev
PORT=4000
